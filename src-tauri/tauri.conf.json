{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Necokara",
  "version": "0.1.0",
  "identifier": "io.github.chrollis.necokara",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Necokara",
        "width": 800,
        "height": 600
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "headerImage": "nsis/installer-header.bmp",
        "sidebarImage": "nsis/installer-sidebar.bmp",
        "installerIcon": "icons/icon.ico",
        "uninstallerIcon": "icons/icon.ico",
        "installMode": "both",
        "displayLanguageSelector": true,
        "compression": "lzma",
        "languages": ["English", "SimpChinese", "TradChinese", "Japanese"],
        "template": "nsis/installer.nsi"
      }
    },
    "resources": {
      "../binaries/mini": "binaries",
      "../python/scripts": "resources/scripts",
      "../docs": "resources/docs"
    }
  },
  "mainBinaryName": "necokara"
}
